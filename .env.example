# Nuxt maps NUXT_-prefixed env vars onto `runtimeConfig` keys, so this one fills
# `runtimeConfig.mailteaApiKey`. It is read only in server/api/send.post.ts and
# never reaches the browser.
NUXT_MAILTEA_API_KEY=mt_pat_your_api_key_here

# A verified sender on a domain you own.
NUXT_MAILTEA_FROM=Your Name <hello@yourdomain.com>

# Only for local dev or a self-hosted Mailtea. Leave unset for https://api.mailtea.app.
# NUXT_MAILTEA_API_BASE_URL=http://localhost:7787
